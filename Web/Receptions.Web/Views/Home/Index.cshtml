@using Receptions.Common
@model Receptions.Web.ViewModels.Home.IndexViewModel
@{
    this.ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Receptions</h1>
    
    <ul>
        <form method="get" asp-action="Index" class="mb-4">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Search here by product or a recipe ..." value="@ViewData["SearchQuery"]" />
                <button type="submit" class="btn btn-primary">Search</button>
            </div>
        </form>

        <li>Recipes: @Model.RecipesCount</li>
        <li>Ingredients: @Model.IngredientsCount</li>
        <li>Categories: @Model.CategoriesCount</li>
        <li>Images: @Model.ImagesCount</li>
    </ul>

    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Предишна</a>
            </li>
            <li class="page-item active" aria-current="page">
                <a class="page-link" href="/1">1</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="/2">2</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="/3">3</a>
            </li>
            <li class="page-item">
                <a class="page-link" href="#">Next</a>
            </li>
        </ul>
    </nav>

</div>
