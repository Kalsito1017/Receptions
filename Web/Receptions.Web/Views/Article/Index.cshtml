@model Receptions.Web.Controllers.ArticleViewModel
@{
    ViewData["Title"] = Model.Title;
}
@{
    var pageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}


<div class="container mt-5 mb-5" style="max-width: 800px;">
    <h1 class="fw-bold">@Model.Title</h1>
    <p class="text-muted">
        Публикувано от <strong>@Model.Author</strong> на
        @Model.Date.ToString("dd MMMM yyyy")
    </p>

    <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded mb-4 shadow-sm" />

    <article class="fs-5" style="line-height: 1.7;">
        @Html.Raw(Model.Content)
    </article>

    <hr />
    <div class="mt-4">
        <p class="text-muted">Сподели статията:</p>

        <a href="https://www.facebook.com/sharer/sharer.php?u=@pageUrl"
           target="_blank"
           class="btn btn-outline-primary btn-sm">
            Facebook
        </a>

        <a href="https://twitter.com/intent/tweet?url=@pageUrl&text=@Model.Title"
           target="_blank"
           class="btn btn-outline-info btn-sm">
            Twitter
        </a>
    </div>
</div>
